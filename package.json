{
  "name": "trabajo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev-prepare.cjs && next dev -H 0.0.0.0 -p 3000",
    "dev:fresh": "node scripts/kill-next-dev-lock.cjs && next dev -H 0.0.0.0 -p 3000",
    "tunnel": "npx --yes cloudflared tunnel --no-autoupdate --url http://localhost:3000",
    "dev:share": "node scripts/free-port-3000.cjs && npx --yes concurrently -k \"node scripts/next-dev-prepare.cjs && next dev -H 0.0.0.0 -p 3000\" \"npx --yes wait-on tcp:127.0.0.1:3000 && npx --yes cloudflared tunnel --no-autoupdate --url http://localhost:3000\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.8.0",
    "mongodb": "^7.1.1",
    "next": "16.2.4",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

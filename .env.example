# WhatsApp Cloud API (Meta). Sin estas claves no se envía nada por WhatsApp (la app responde whatsapp: "skipped").
# Obtén token e ID en https://developers.facebook.com/ → tu app → WhatsApp → API setup
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Opcional — destino en dígitos sin + (México ejemplo: 526632322712). Si lo omites, usa el número por defecto del proyecto.
# WHATSAPP_EXIT_NOTIFY_TO=526632322712

# Correo al tutor (opcional)
# EMAIL_USER=
# EMAIL_PASS=

# CallMeBot WhatsApp
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
